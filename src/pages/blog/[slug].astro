---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const categoryTagMap: Record<string, string> = {
  "相続": "相続",
  "空き家活用": "空き家",
  "不動産": "不動産",
};

// Get related posts (same category, excluding current)
const allPosts = await getCollection("blog");
const related = allPosts
  .filter((p) => p.data.category === post.data.category && p.id !== post.id)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .slice(0, 5);
---

<Base title={post.data.title} description={`${post.data.title} | 株式会社玄風のコラム`}>

  <article class="article-page">
    <div class="container">

      <div class="article-layout">
        <!-- Main content -->
        <div class="article-main">
          <div class="article-meta">
            <span class="article-category">
              {categoryTagMap[post.data.category] ?? post.data.category}
            </span>
            {post.data.series && (
              <span class="article-series">{post.data.series} 第{post.data.order}回</span>
            )}
          </div>

          <div class="article-content prose">
            <Content />
          </div>

          <!-- CTA after article -->
          <div class="article-cta">
            <h3>相続・空き家でお悩みですか？</h3>
            <p>株式会社玄風は、提携士業と連携し相続から不動産売却まで対応します。まずはお気軽にご相談ください。</p>
            <div class="article-cta-btns">
              <a href="/contact/" class="btn btn-primary">無料相談はこちら</a>
              <a href="https://lin.ee/6LnzTps" class="btn btn-line">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 5.82 2 10.5c0 4.21 3.74 7.74 8.79 8.4.34.07.81.23.93.52.1.27.07.68.03.95l-.15.91c-.05.28-.22 1.1.96.6s6.37-3.75 8.69-6.42C23.08 13.4 22 11.17 22 10.5 22 5.82 17.52 2 12 2z"/></svg>
                LINEで相談
              </a>
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <aside class="article-sidebar">
          <div class="sidebar-block">
            <h4 class="sidebar-title">関連コラム</h4>
            <ul class="sidebar-list">
              {related.map((r) => (
                <li>
                  <a href={`/blog/${r.id}/`}>{r.data.title}</a>
                </li>
              ))}
            </ul>
          </div>

          <div class="sidebar-block sidebar-cta">
            <h4 class="sidebar-title">無料相談受付中</h4>
            <p>相続・空き家のお悩み、お気軽にご相談ください。</p>
            <a href="/contact/" class="btn btn-primary" style="width:100%;margin-bottom:8px;">お問い合わせ</a>
            <a href="https://lin.ee/6LnzTps" class="btn btn-line" style="width:100%;">LINE相談</a>
          </div>

          <div class="sidebar-block">
            <h4 class="sidebar-title">カテゴリ</h4>
            <ul class="sidebar-list">
              <li><a href="/blog/">すべてのコラム</a></li>
            </ul>
          </div>
        </aside>
      </div>

    </div>
  </article>

</Base>

<style>
  .article-page {
    padding: 48px 0 80px;
  }
  .article-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 48px;
  }
  .article-meta {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-bottom: 24px;
  }
  .article-category {
    background: var(--color-primary-bg);
    color: var(--color-primary-dark);
    padding: 4px 14px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .article-series {
    font-size: 0.8rem;
    color: var(--color-text-light);
  }

  /* Prose (article body) */
  .prose :global(h1) {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    line-height: 1.5;
    margin-bottom: 24px;
    color: var(--color-text);
  }
  .prose :global(h2) {
    font-size: 1.3rem;
    font-weight: 700;
    margin: 40px 0 16px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--color-primary-bg);
    color: var(--color-primary-dark);
  }
  .prose :global(h3) {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 28px 0 12px;
    color: var(--color-text);
  }
  .prose :global(p) {
    margin-bottom: 16px;
    line-height: 1.9;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 16px 0;
    padding-left: 24px;
  }
  .prose :global(ul) {
    list-style: disc;
  }
  .prose :global(ol) {
    list-style: decimal;
  }
  .prose :global(li) {
    margin-bottom: 8px;
    line-height: 1.7;
  }
  .prose :global(strong) {
    color: var(--color-primary-dark);
  }
  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 32px 0;
  }
  .prose :global(blockquote) {
    border-left: 4px solid var(--color-primary);
    padding: 12px 20px;
    margin: 20px 0;
    background: var(--color-primary-bg);
    border-radius: 0 8px 8px 0;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 20px 0;
  }
  .prose :global(th),
  .prose :global(td) {
    border: 1px solid var(--color-border);
    padding: 10px 14px;
    text-align: left;
    font-size: 0.9rem;
  }
  .prose :global(th) {
    background: var(--color-primary-bg);
    font-weight: 700;
  }

  /* Article CTA */
  .article-cta {
    margin-top: 48px;
    padding: 32px;
    background: var(--color-primary-bg);
    border-radius: 12px;
    text-align: center;
  }
  .article-cta h3 {
    font-size: 1.2rem;
    margin-bottom: 12px;
    color: var(--color-primary-dark);
  }
  .article-cta p {
    font-size: 0.9rem;
    color: var(--color-text-light);
    margin-bottom: 20px;
    line-height: 1.7;
  }
  .article-cta-btns {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Sidebar */
  .sidebar-block {
    margin-bottom: 28px;
    padding: 20px;
    background: var(--color-bg-light);
    border-radius: 12px;
  }
  .sidebar-title {
    font-size: 0.9rem;
    font-weight: 700;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--color-primary);
    color: var(--color-primary-dark);
  }
  .sidebar-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .sidebar-list li a {
    font-size: 0.85rem;
    color: var(--color-text);
    line-height: 1.5;
    text-decoration: none;
  }
  .sidebar-list li a:hover {
    color: var(--color-primary);
  }
  .sidebar-cta p {
    font-size: 0.85rem;
    color: var(--color-text-light);
    margin-bottom: 16px;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .article-layout {
      grid-template-columns: 1fr;
    }
    .prose :global(h1) {
      font-size: 1.4rem;
    }
  }
</style>
