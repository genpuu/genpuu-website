    <script>
      const GAS_URL = "https://script.google.com/macros/s/AKfycbyS0J98dyovB5K1yp7b288O3puDtFSA3XHo24Yk9Ote07E4OnVrIIziXS6BXMDSCeBUiw/exec";

      const form = document.getElementById("lp-contact-form") as HTMLFormElement;
      const thanks = document.getElementById("lp-form-thanks") as HTMLElement;
      const submitBtn = document.getElementById("lp-submit-btn") as HTMLButtonElement;

      form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        submitBtn.disabled = true;
        submitBtn.textContent = "送信中...";

        const formData = new FormData(form);
        const concerns = formData.getAll("concern").join("、");
        const data = {
          name: formData.get("name"),
          email: formData.get("email") || "",
          phone: formData.get("phone"),
          category: "相続（LP）",
          message: `【エリア】${formData.get("area") || "未選択"}\n【お悩み】${concerns}\n\n${formData.get("message") || ""}`,
        };

        try {
          await fetch(GAS_URL, {
            method: "POST",
            mode: "no-cors",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
          });
          form.style.display = "none";
          thanks.style.display = "block";
        } catch (err) {
          alert("送信に失敗しました。お手数ですがお電話（050-8884-9984）でお問い合わせください。");
          submitBtn.disabled = false;
          submitBtn.textContent = "無料相談を申し込む";
        }
      });
    </script>

