---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import fs from "node:fs";
import path from "node:path";

export async function getStaticPaths() {
  const properties = await getCollection("properties");
  return properties.map((prop) => {
    // 画像フォルダから全画像を取得
    const imageDir = prop.data.image.replace(/\/[^/]+$/, "");
    const fullDir = path.join(process.cwd(), "public", imageDir);
    let galleryImages: { src: string; label: string }[] = [];
    try {
      const files = fs.readdirSync(fullDir)
        .filter((f: string) => /\.(jpg|jpeg|png|webp)$/i.test(f))
        .sort((a: string, b: string) => {
          // 外観を先頭、main.jpgは除外（外観➀と重複）
          if (a === "main.jpg") return 1;
          if (b === "main.jpg") return -1;
          if (a.startsWith("外観") && !b.startsWith("外観")) return -1;
          if (!a.startsWith("外観") && b.startsWith("外観")) return 1;
          return a.localeCompare(b, "ja");
        })
        .filter((f: string) => f !== "main.jpg");
      galleryImages = files.map((f: string) => ({
        src: `${imageDir}/${f}`,
        label: f.replace(/\.(jpg|jpeg|png|webp)$/i, ""),
      }));
    } catch {}
    return {
      params: { slug: prop.id },
      props: { property: prop, galleryImages },
    };
  });
}

const { property, galleryImages } = Astro.props;
const { Content } = await render(property);
const d = property.data;

const statusColor: Record<string, string> = {
  "販売中": "#2e8b57",
  "商談中": "#e67e22",
  "成約済": "#999",
};

// 値が空文字・未定義の項目は自動省略
const infoRowsDef: [string, string | undefined][] = [
  ["所在", d.address],
  ["価格", d.price],
  ["種別", d.type],
  ["駅・交通", d.access],
  ["間取り", d.layout],
  ["土地面積", d.landArea],
  ["建物面積", d.buildingArea],
  ["小学校区", d.elementarySchool],
  ["中学校区", d.juniorHighSchool],
  ["階建", d.floors],
  ["土地権利", d.landRight],
  ["築年月", d.buildYear],
  ["建物構造", d.structure],
  ["駐車場", d.parking],
  ["都市計画", d.cityPlanning],
  ["用途地域", d.zoning],
  ["地目", d.landCategory],
  ["建・容率", d.buildingCoverageRatio],
  ["地勢", d.terrain],
  ["接道状況", d.roadAccess],
  ["現況", d.currentState],
  ["引渡し時期", d.delivery],
  ["取引態様", d.transactionType],
];
const infoRows = infoRowsDef.filter(([, v]) => v && v.trim() !== "") as [string, string][];
---

<Base title={`${d.title} | 物件情報`} description={`${d.address}の${d.type}。${d.price}。${d.title}の詳細情報。株式会社玄風`}>

  <section class="property-detail-hero">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">ホーム</a>
        <span>/</span>
        <span>物件情報</span>
        <span>/</span>
        <span>{d.title}</span>
      </nav>
    </div>
  </section>

  <section class="section property-detail-section">
    <div class="container">
      <div class="property-detail-grid">

        <div class="property-detail-main">
          <div class="property-detail-img-wrap">
            <img src={d.image} alt={d.title} />
            <span class="property-detail-status" style={`background:${statusColor[d.status] ?? '#888'}`}>
              {d.status}
            </span>
          </div>

          <div class="property-detail-body">
            <h1 class="property-detail-title">{d.title}</h1>
            <p class="property-detail-price">{d.price}</p>

            {d.description && (
              <p class="property-detail-desc">{d.description}</p>
            )}

            <div class="property-detail-content">
              <Content />
            </div>
          </div>

          {galleryImages.length > 0 && (
            <div class="property-gallery">
              <h2 class="gallery-heading">写真ギャラリー</h2>
              <div class="gallery-grid">
                {galleryImages.map((img: { src: string; label: string }) => (
                  <div class="gallery-item" data-src={img.src}>
                    <img src={img.src} alt={img.label} loading="lazy" />
                    <span class="gallery-label">{img.label}</span>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Lightbox -->
          <div class="lightbox" id="lightbox">
            <button class="lightbox-close" id="lightboxClose">&times;</button>
            <button class="lightbox-prev" id="lightboxPrev">&#8249;</button>
            <img class="lightbox-img" id="lightboxImg" src="" alt="" />
            <button class="lightbox-next" id="lightboxNext">&#8250;</button>
            <p class="lightbox-label" id="lightboxLabel"></p>
          </div>
        </div>

        <aside class="property-detail-sidebar">
          <div class="property-info-table-wrap">
            <h2 class="sidebar-heading">物件概要</h2>
            <table class="property-info-table">
              <tbody>
                {infoRows.map(([label, value]) => (
                  <tr>
                    <th>{label}</th>
                    <td>{value}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="property-cta-box">
            <p class="property-cta-lead">この物件が気になる方は</p>
            <a href="/contact/" class="btn btn-primary btn-block">無料相談はこちら</a>
            <a href="https://lin.ee/6LnzTps" class="btn btn-line btn-block">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 5.82 2 10.5c0 4.21 3.74 7.74 8.79 8.4.34.07.81.23.93.52.1.27.07.68.03.95l-.15.91c-.05.28-.22 1.1.96.6s6.37-3.75 8.69-6.42C23.08 13.4 22 11.17 22 10.5 22 5.82 17.52 2 12 2z"/></svg>
              LINEで相談する
            </a>
          </div>
        </aside>

      </div>
    </div>
  </section>

  <section class="section cta-bottom-section">
    <div class="container cta-bottom-inner">
      <h2>まずは無料相談から始めませんか？</h2>
      <p>物件に関するご質問やご相談はお気軽にどうぞ。</p>
      <div class="cta-bottom-btns">
        <a href="/contact/" class="btn btn-primary btn-lg">無料相談はこちら</a>
      </div>
    </div>
  </section>

</Base>

<style>
  .property-detail-hero {
    padding: 100px 20px 20px;
    background: var(--color-primary-bg);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--color-text-light);
  }
  .breadcrumb a {
    color: var(--color-primary);
    text-decoration: none;
  }
  .breadcrumb a:hover { text-decoration: underline; }

  .property-detail-section { padding-top: 40px; }

  .property-detail-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 40px;
    align-items: start;
  }

  .property-detail-img-wrap {
    position: relative;
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 32px;
    background: #f0f0f0;
  }
  .property-detail-img-wrap img {
    width: 100%;
    height: auto;
    display: block;
  }

  .property-detail-status {
    position: absolute;
    top: 16px;
    left: 16px;
    color: #fff;
    padding: 6px 18px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .property-detail-title {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 700;
    margin-bottom: 8px;
    color: var(--color-text);
  }

  .property-detail-price {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    margin-bottom: 20px;
  }

  .property-detail-desc {
    font-size: 1rem;
    color: var(--color-text-light);
    line-height: 1.8;
    margin-bottom: 24px;
    padding: 20px;
    background: var(--color-primary-bg);
    border-radius: 12px;
  }

  .property-detail-content {
    font-size: 0.95rem;
    line-height: 1.9;
    color: var(--color-text);
  }
  .property-detail-content :global(p) { margin-bottom: 1em; }

  /* Sidebar */
  .property-detail-sidebar {
    position: sticky;
    top: 100px;
  }

  .property-info-table-wrap {
    background: #fff;
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    margin-bottom: 20px;
  }

  .sidebar-heading {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--color-primary);
  }

  .property-info-table {
    width: 100%;
    border-collapse: collapse;
  }
  .property-info-table th,
  .property-info-table td {
    padding: 10px 0;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.9rem;
    vertical-align: top;
  }
  .property-info-table th {
    width: 80px;
    font-weight: 600;
    color: var(--color-text-light);
  }

  .property-cta-box {
    background: #fff;
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    text-align: center;
  }
  .property-cta-lead {
    font-weight: 600;
    margin-bottom: 16px;
    color: var(--color-primary-dark);
  }
  .btn-block {
    display: block;
    width: 100%;
    text-align: center;
    margin-bottom: 10px;
  }

  /* CTA bottom reuse */
  .cta-bottom-section {
    background: linear-gradient(135deg, #1a3a2a 0%, #2e8b57 100%);
    color: #fff;
  }
  .cta-bottom-inner { text-align: center; }
  .cta-bottom-inner h2 {
    font-family: var(--font-heading);
    font-size: 2rem;
    margin-bottom: 16px;
  }
  .cta-bottom-inner p {
    font-size: 1rem;
    opacity: 0.9;
    margin-bottom: 32px;
  }
  .cta-bottom-btns {
    display: flex;
    gap: 16px;
    justify-content: center;
  }
  .btn-lg { padding: 16px 40px; font-size: 1.05rem; }

  /* Gallery */
  .property-gallery {
    margin-top: 40px;
  }
  .gallery-heading {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--color-primary);
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .gallery-item {
    position: relative;
    border-radius: 10px;
    overflow: hidden;
    cursor: pointer;
    aspect-ratio: 4/3;
    background: #f0f0f0;
  }
  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }
  .gallery-item:hover img {
    transform: scale(1.05);
  }
  .gallery-label {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(0,0,0,0.6);
    color: #fff;
    padding: 6px 10px;
    font-size: 0.75rem;
    text-align: center;
  }

  /* Lightbox */
  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0,0,0,0.92);
    align-items: center;
    justify-content: center;
    flex-direction: column;
  }
  .lightbox.active { display: flex; }
  .lightbox-img {
    max-width: 90vw;
    max-height: 80vh;
    object-fit: contain;
    border-radius: 8px;
  }
  .lightbox-close {
    position: absolute;
    top: 20px;
    right: 24px;
    background: none;
    border: none;
    color: #fff;
    font-size: 2.5rem;
    cursor: pointer;
    z-index: 10;
  }
  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255,255,255,0.15);
    border: none;
    color: #fff;
    font-size: 2.5rem;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s;
  }
  .lightbox-prev:hover,
  .lightbox-next:hover { background: rgba(255,255,255,0.3); }
  .lightbox-prev { left: 20px; }
  .lightbox-next { right: 20px; }
  .lightbox-label {
    color: #fff;
    margin-top: 12px;
    font-size: 0.9rem;
  }

  @media (max-width: 768px) {
    .property-detail-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .property-detail-sidebar {
      position: static;
    }
    .property-detail-title { font-size: 1.3rem; }
    .property-detail-price { font-size: 1.6rem; }
    .cta-bottom-inner h2 { font-size: 1.4rem; }
    .btn-lg { padding: 14px 28px; font-size: 0.95rem; }
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const items = document.querySelectorAll(".gallery-item");
    const lightbox = document.getElementById("lightbox") as HTMLElement;
    const lbImg = document.getElementById("lightboxImg") as HTMLImageElement;
    const lbLabel = document.getElementById("lightboxLabel") as HTMLElement;
    const lbClose = document.getElementById("lightboxClose") as HTMLElement;
    const lbPrev = document.getElementById("lightboxPrev") as HTMLElement;
    const lbNext = document.getElementById("lightboxNext") as HTMLElement;
    if (!lightbox || !lbImg || !lbClose) return;

    let currentIdx = 0;
    const images = Array.from(items).map((el) => ({
      src: el.getAttribute("data-src") || "",
      label: el.querySelector(".gallery-label")?.textContent || "",
    }));

    function show(idx: number) {
      currentIdx = idx;
      lbImg.src = images[idx].src;
      lbLabel.textContent = images[idx].label;
      lightbox.classList.add("active");
      document.body.style.overflow = "hidden";
    }
    function close() {
      lightbox.classList.remove("active");
      document.body.style.overflow = "";
    }

    items.forEach((item, i) => item.addEventListener("click", () => show(i)));
    lbClose.addEventListener("click", close);
    lightbox.addEventListener("click", (e) => { if (e.target === lightbox) close(); });
    lbPrev.addEventListener("click", (e) => { e.stopPropagation(); show((currentIdx - 1 + images.length) % images.length); });
    lbNext.addEventListener("click", (e) => { e.stopPropagation(); show((currentIdx + 1) % images.length); });
    document.addEventListener("keydown", (e) => {
      if (!lightbox.classList.contains("active")) return;
      if (e.key === "Escape") close();
      if (e.key === "ArrowLeft") show((currentIdx - 1 + images.length) % images.length);
      if (e.key === "ArrowRight") show((currentIdx + 1) % images.length);
    });
  });
</script>
