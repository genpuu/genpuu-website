---
import Base from "../layouts/Base.astro";

const formAction = "https://docs.google.com/forms/d/e/1FAIpQLScNqbsVWt-PuWz5xaImWb3r91jkf2fveeG-BGaItZpnJr7DzQ/formResponse";
---

<Base title="お問い合わせ" description="株式会社玄風へのお問い合わせ。相続・空き家・不動産に関するご相談を無料で承ります。">

  <section class="page-hero">
    <div class="container">
      <h1 class="page-hero-title">お問い合わせ</h1>
      <p class="page-hero-desc">Contact</p>
    </div>
  </section>

  <section class="section">
    <div class="container">

      <div class="contact-intro-block fade-in">
        <h2 class="contact-heading">お気軽にご相談ください</h2>
        <p class="contact-intro">
          相続・空き家・不動産に関するご相談を無料で承ります。<br>
          お電話・LINE・フォームよりお問い合わせください。
        </p>
      </div>

      <div class="contact-methods fade-in">
        <div class="method-card">
          <div class="method-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="var(--color-primary)"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
          </div>
          <h3>お電話でのご相談</h3>
          <a href="tel:050-8884-9984" class="phone-number">050-8884-9984</a>
          <p class="method-detail">お電話での無料相談を承っております。</p>
          <p class="method-note">受付時間: 9:00〜18:00（土日祝休み）</p>
        </div>

        <div class="method-card">
          <div class="method-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="var(--color-line)"><path d="M12 2C6.48 2 2 5.82 2 10.5c0 4.21 3.74 7.74 8.79 8.4.34.07.81.23.93.52.1.27.07.68.03.95l-.15.91c-.05.28-.22 1.1.96.6s6.37-3.75 8.69-6.42C23.08 13.4 22 11.17 22 10.5 22 5.82 17.52 2 12 2z"/></svg>
          </div>
          <h3>LINEでのご相談</h3>
          <p class="method-detail">LINEで気軽にご相談いただけます。</p>
          <a href="#LINE_URL" class="btn btn-line" style="margin-top: 12px;">
            友だち追加して相談する
          </a>
        </div>
      </div>

      <div class="form-section fade-in">
        <h2 class="contact-heading">フォームからのお問い合わせ</h2>

        <!-- 送信前フォーム -->
        <form
          id="contact-form"
          action={formAction}
          method="POST"
          target="hidden-iframe"
          class="contact-form"
        >
          <div class="form-group">
            <label for="name">お名前 <span class="required">必須</span></label>
            <input type="text" id="name" name="entry.1743182690" required placeholder="例：山田 太郎">
          </div>
          <div class="form-group">
            <label for="email">メールアドレス <span class="required">必須</span></label>
            <input type="email" id="email" name="entry.49810583" required placeholder="例：example@email.com">
          </div>
          <div class="form-group">
            <label for="phone">電話番号 <span class="required">必須</span></label>
            <input type="tel" id="phone" name="entry.664589103" required placeholder="例：090-1234-5678">
          </div>
          <div class="form-group">
            <label for="category">ご相談内容 <span class="required">必須</span></label>
            <select id="category" name="entry.685381743" required>
              <option value="">選択してください</option>
              <option value="保有物件のご売却">保有物件のご売却</option>
              <option value="物件のご購入">物件のご購入</option>
              <option value="相続">相続</option>
              <option value="解体工事">解体工事</option>
              <option value="その他">その他</option>
            </select>
          </div>
          <div class="form-group">
            <label for="message">ご相談内容の詳細 <span class="required">必須</span></label>
            <textarea id="message" name="entry.40921669" rows="6" required placeholder="お気軽にご記入ください"></textarea>
          </div>
          <button type="submit" class="btn btn-primary btn-lg submit-btn">
            送信する
          </button>
        </form>

        <!-- 送信完了メッセージ -->
        <div id="form-thanks" class="form-thanks" style="display: none;">
          <div class="thanks-icon">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <h3>お問い合わせありがとうございます</h3>
          <p>内容を確認のうえ、担当者よりご連絡いたします。<br>しばらくお待ちください。</p>
        </div>

        <iframe name="hidden-iframe" id="hidden-iframe" style="display:none;"></iframe>
      </div>

    </div>
  </section>

</Base>

<style>
  .page-hero {
    background: linear-gradient(135deg, #1a3a2a 0%, #2e8b57 100%);
    color: #fff;
    padding: 80px 0 48px;
    text-align: center;
  }
  .page-hero-title {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    margin-bottom: 8px;
  }
  .page-hero-desc {
    font-size: 0.9rem;
    opacity: 0.6;
    letter-spacing: 2px;
  }

  .contact-intro-block {
    text-align: center;
    margin-bottom: 40px;
  }
  .contact-heading {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    margin-bottom: 12px;
  }
  .contact-intro {
    font-size: 0.95rem;
    color: var(--color-text-light);
    line-height: 1.8;
  }

  .contact-methods {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 48px;
  }
  .method-card {
    padding: 28px;
    background: var(--color-bg-light);
    border-radius: 12px;
    border: 1px solid var(--color-border);
  }
  .method-icon {
    margin-bottom: 12px;
  }
  .method-card h3 {
    font-size: 1.05rem;
    margin-bottom: 8px;
    color: var(--color-text);
  }
  .phone-number {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    text-decoration: none;
    margin-bottom: 8px;
  }
  .phone-number:hover {
    color: var(--color-primary);
  }
  .method-detail {
    font-size: 0.9rem;
    color: var(--color-text-light);
    margin-bottom: 4px;
  }
  .method-note {
    font-size: 0.8rem;
    color: var(--color-text-light);
  }

  /* Form */
  .form-section {
    max-width: 640px;
    margin: 0 auto;
  }
  .form-section .contact-heading {
    text-align: center;
    margin-bottom: 28px;
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .form-group label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .required {
    color: #e74c3c;
    font-size: 0.75rem;
    margin-left: 4px;
  }
  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 14px 16px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    font-size: 0.95rem;
    font-family: var(--font-body);
    background: var(--color-bg-light);
    transition: all 0.3s;
  }
  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(46, 139, 87, 0.1);
    background: #fff;
  }
  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: #bbb;
  }
  .submit-btn {
    width: 100%;
    margin-top: 8px;
  }

  /* Thanks */
  .form-thanks {
    text-align: center;
    padding: 48px 20px;
    background: var(--color-primary-bg);
    border-radius: 16px;
  }
  .thanks-icon {
    margin-bottom: 20px;
  }
  .form-thanks h3 {
    font-size: 1.3rem;
    color: var(--color-primary-dark);
    margin-bottom: 12px;
  }
  .form-thanks p {
    font-size: 0.95rem;
    color: var(--color-text-light);
    line-height: 1.8;
  }

  @media (max-width: 768px) {
    .contact-methods {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const thanks = document.getElementById("form-thanks") as HTMLElement;

  form?.addEventListener("submit", () => {
    setTimeout(() => {
      form.style.display = "none";
      thanks.style.display = "block";
    }, 500);
  });
</script>
